# Example .env file (copy to .env and edit values)
# Spotify credentials (required)
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=

# Developer panel PIN (optional)
DEV_PIN=1234
REQUIRE_CONTROL_PIN=true

# Server listen
HOST=127.0.0.1
PORT=8080

# Weather
WEATHER_CITY=paris

# -----------------------------
# Free Mobile SMS notifications
# Set FREE_SMS_ENABLED=true to enable SMS notifications and fill user/pass
# FREE_SMS_USER: votre identifiant Free (numéro de téléphone ou identifiant fourni)
# FREE_SMS_PASS: clé d'identification fournie par Free Mobile
# FREE_SMS_NOTIFY_*: toggles pour choisir quels événements envoient un SMS
# FREE_SMS_MIN_INTERVAL: intervalle minimum (secondes) entre deux SMS du même type
# -----------------------------
FREE_SMS_ENABLED=false
FREE_SMS_USER=
FREE_SMS_PASS=
FREE_SMS_NOTIFY_PIN=true
FREE_SMS_NOTIFY_QUOTA=true
FREE_SMS_NOTIFY_METRICS=true
FREE_SMS_MIN_INTERVAL=60

# NOTE: Ne commitez pas vos vraies clés dans un dépôt public. Utilisez .env local.
# Exemple de fichier .env pour Dashboard Kiosk Spotify
# Remplacez les valeurs par vos propres identifiants.
# NE COMMETTEZ PAS ce fichier dans un repo public si vous y mettez des vraies clefs.

# --- Spotify OAuth (obligatoire) ---
# Créez une app sur https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here
# Exemple: http://127.0.0.1:8888/callback
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Paramètres de l'application ---
# Ville utilisée pour le widget météo (wttr.in)
# Format recommandé: en minuscules, sans accents. Utilisez + pour les espaces.
# Exemples valides: paris  |  new+york  |  los+angeles
WEATHER_CITY=paris

# Hôte et port d'écoute de Flask
HOST=127.0.0.1
PORT=8080

# --- Panneau développeur (PIN) ---
# Code PIN administrateur pour ouvrir le panneau dev (sécurisez ce code !)
# Remplacez la valeur exemple par votre PIN dans votre fichier `.env` local.
# NE COMMITTEZ PAS une vraie valeur secrète dans un repo public.
DEV_PIN=0000

# (Optionnel) Ajustez les limites de quota ou autres variables si besoin
# API_LIMIT_PER_MIN=300
# API_LIMIT_PER_DAY=8000
